# Port Server
PORT=3001
NODE_ENV=development

# Database mode: 'postgres' (Neon/PostgreSQL via Prisma) atau 'memory' (demo instan tanpa DB)
DB_MODE=memory

# Koneksi database (wajib diisi jika DB_MODE=postgres) — dipakai oleh Prisma
# Neon (pooler):
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.c-xx.aws.neon.tech/neondb?sslmode=require
# Atau PostgreSQL lokal:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# Supabase REST / Auth (opsional jika memakai Supabase SDK)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret untuk otentikasi mandiri backend
JWT_SECRET=super-secret-kateringku-jwt-key-min-32-chars-length
JWT_EXPIRES_IN=7d

# CORS Origin
CORS_ORIGIN=*
